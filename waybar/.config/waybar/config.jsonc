{
  "layer": "top",
  "position": "top",
  "height": 20,
  "spacing": 6,
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["custom/spotify"],
  "modules-right": [
    "hyprland/language",
    "custom/divider",
    "memory",
    "custom/separator",
    "cpu",
    "custom/separator",
    "temperature",
    "custom/divider",
    "backlight",
    "custom/separator",
    "pulseaudio#mic",
    "custom/separator",
    "pulseaudio",
    "custom/divider",
    "bluetooth",
    "custom/separator",
    "custom/network",
    "custom/divider",
    // "custom/auto-cpufreq",
    "battery",
    "custom/divider",
    "clock",
    "custom/separator",
    "clock#date",
  ],
  "include": ["~/.config/waybar/modules.json"],
}
