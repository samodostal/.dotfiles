{
  "hyprland/workspaces": {
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": [],
      "6": [],
      "7": [],
      "8": [],
      "9": []
    }
  },
  "custom/spotify": {
    "format": "{}",
    "exec": "~/.dotfiles/scripts/.config/shell_scripts/spotify-status.sh",
    "interval": 1,
    "tooltip": false
  },
  "memory": {
    "format": " {used}GB",
    "tooltip": false
  },
  "cpu": {
    "format": " {usage}%",
    "tooltip": false
  },
  "backlight": {
    "format": "󰃠 {percent}%",
    "tooltip": false
  },
	"pulseaudio": {
		"format": "{icon} {volume}  {format_source}",
		"format-bluetooth": "{icon} {volume}  {format_source}",
		"format-muted": " {volume}  {format_source}",
		"format-source": "",
		"format-source-muted": "",
		"format-icons": {
			"headphone": "",
			"default": [""]
		},
		"tooltip": false
	},
  "custom/auto-cpufreq": {
    "format": "{}",
    "exec": "~/.dotfiles/scripts/.config/shell_scripts/auto-cpufreq-status.sh",
    "interval": 10,
    "tooltip": false
  },
  "battery": {
    "format": " {capacity}%",
    "format-charging": "󰂅 {capacity}%",
    "tooltip": false
  },
  "clock": {
    "format": " {:%H:%M:%S | %d-%m}",
    "interval": 1,
    "tooltip": false
  }
}
