{
  "hyprland/workspaces": {
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": [],
      "6": [],
      "7": [],
      "8": [],
      "9": []
    }
  },
  "custom/spotify": {
    "format": "{}",
    "exec": "~/.dotfiles/scripts/.config/shell_scripts/spotify-status.sh",
    "interval": 1,
    "tooltip": false
  },
  "memory": {
    "format": " {used}GB",
    "tooltip": false
  },
  "cpu": {
    "format": " {usage}%",
    "tooltip": false
  },
  "temperature": {
    "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
    "input-filename": "temp1_input",
    "interval": 2,
    "warning-threshold": 85,
    "critical-threshold": 95,
    "format": " {temperatureC}°C",
    "tooltip": false
  },
  "backlight": {
    "format": "󰃠 {percent}%",
    "tooltip": false
  },
	"pulseaudio": {
		"format": "{format_source}  {icon} {volume}",
		"format-bluetooth": "{format_source}  {icon} {volume}",
		"format-muted": " {format_source}  {volume}",
		"format-source": "",
		"format-source-muted": "",
		"format-icons": {
			"headphone": "",
			"default": [""]
		},
		"tooltip": false
	},
  "custom/auto-cpufreq": {
    "format": "{}",
    "exec": "~/.dotfiles/scripts/.config/shell_scripts/auto-cpufreq-status.sh",
    "interval": 10,
    "tooltip": false
  },
  "battery": {
    "format": " {capacity}%",
    "format-charging": "󰂅 {capacity}%",
    "tooltip": false
  },
  "clock": {
    "format": " {:%H:%M:%S | %d-%m}",
    "interval": 1,
    "tooltip": false
  }
}
